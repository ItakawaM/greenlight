# VCS
.git
.gitignore
.github

# IDE
.idea
.vscode

# Remote
remote/

# Environment / secrets
.env
.env.example

# Compiled binary (built inside the container, not copied in)
bin/

# Docker-related files (no need to send these into build context)
docker-compose.yml
docker-compose.development.yml
docker/

# Documentation output (generated by CI, not part of the app image)
/api/

# Misc
README.md
LICENSE
Makefile
Makefile.docs

# Test/coverage artifacts if you have them
*_test.go
*.test
*.out
coverage.*

# OS cruft
.DS_Store
